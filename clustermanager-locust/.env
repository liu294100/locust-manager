# 数据库配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=locust_manager

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Flask配置
SECRET_KEY=locust-manager-secret-key-2024
FLASK_ENV=development
FLASK_DEBUG=true

# 应用配置
APP_HOST=0.0.0.0
APP_PORT=8088
BASE_LOCUST_PORT=8089

# 集群配置
CLUSTER_MODE=true
CLUSTER_NODE_ID=node-1
CLUSTER_HEARTBEAT_INTERVAL=30

# 文件上传配置
UPLOAD_FOLDER=scripts/tmp
MAX_CONTENT_LENGTH=16777216

# AWS S3配置（预留扩展）
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=
S3_ENABLED=false